rules_version = '2';

// Floor Link — role-based Firestore rules (Firebase Auth + Custom Claims).
//
// The role claim is set by a scheduled GitHub Action (not a Cloud Function —
// see /scripts/sync-roles.js), reading the "role" field already present on
// each /users/{uid} document and writing it to that user's Auth token as a
// custom claim. There's a short delay (a few minutes, per the sync
// schedule) between changing someone's role and that change taking effect
// here — that's expected, not a bug.
//
// Collections NOT mentioned below (handovers, merch_visits, catalog,
// quick_shortages, settings, fcm_tokens) keep today's simple behavior:
// open to any signed-in user, no role distinction yet.
//
// delivery_shifts: written by the offline branch delivery book
// (shoppies-delivery.html), signed in as an account whose role is
// "delivery". Only admins can read them. Delivery accounts can do
// nothing else in the database.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }
    function isDelivery() {
      return isSignedIn() && request.auth.token.role == 'delivery';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------------- users ----------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.role in ['supervisor', 'merchandiser'];
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ---------------- expiry_items ----------------
    match /expiry_items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy.userId == request.auth.uid
                    && request.resource.data.status == 'active';
      allow update: if isAdmin()
                    || (isSignedIn()
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['status', 'deletedInfo']));
      allow delete: if isAdmin();
    }

    // ---------------- activity_log ----------------
    match /activity_log/{logId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // ---------------- delivery_shifts ----------------
    // Branch delivery books send one document per branch / day / shift.
    // A delivery account may create or re-send its own shifts, never read.
    match /delivery_shifts/{shiftId} {
      allow read, delete: if isAdmin();
      allow create, update: if isDelivery()
                            && request.resource.data.by == request.auth.uid;
    }

    // ---------------- everything else (unchanged scope for now) ----------------
    // Same as before for every collection, except: delivery accounts are kept
    // out, and delivery_shifts is never opened up by this catch-all.
    match /{collection}/{document=**} {
      allow read, write: if isSignedIn()
                         && !isDelivery()
                         && collection != 'delivery_shifts';
    }
  }
}
