rules_version = '2';

// Floor Link — role-based Firestore rules (Firebase Auth + Custom Claims).
//
// The "role" claim is set by a scheduled GitHub Action (scripts/sync-roles.js)
// from the "role" field on each /users/{uid} document, with a few minutes'
// delay. The read-only "viewer" role is checked from the /users document
// directly (not the claim), so a new viewer is limited from their very first
// sign-in, and the branches they may see come from that same document:
//   companies:        ["omar_mina", "omar_abrin", ...]   (handover, merch, expiry, shortages)
//   deliveryBranches: ["<branch name exactly as the delivery book writes it>", ...]
// The manager ticks both lists in the app's Accounts screen.
//
// Customer feedback (Oct 2026): feedback_codes (QR codes), feedback (replies),
// feedback_rate (spam limit per device). Only managers read feedback.

service cloud.firestore {
  match /databases/{database}/documents {

    // Customers on the public feedback page sign in ANONYMOUSLY. They never
    // count as signed-in employees; they can only send feedback (see below).
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function myDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function myRole() {
      return exists(myDocPath()) ? get(myDocPath()).data.get('role', '') : '';
    }
    function isViewer() {
      return isSignedIn() && myRole() == 'viewer';
    }
    // New self-registered accounts start with approved == false and can do nothing but wait
    // until the manager approves them (Nov 2026). Accounts without the field (all the
    // existing ones, and the ones the manager creates) count as approved.
    function isApproved() {
      return exists(myDocPath()) && get(myDocPath()).data.get('approved', true) != false;
    }
    // Kitchen-only accounts (role "kitchen", Kitchen OS, Nov 2026) are NOT Floor Link staff:
    // they sign in with the same login but see only the kitchen (rules near the bottom).
    function isStaff() {
      return isSignedIn() && isApproved() && myRole() != 'kitchen';
    }
    // Manager by claim, or by the users document (covers older "manager" accounts
    // and the minutes before the claim sync runs).
    function isManager() {
      return isAdmin() || (isSignedIn() && myRole() in ['admin', 'manager']);
    }
    function viewerCompanies() {
      return get(myDocPath()).data.get('companies', []);
    }
    function viewerDeliveryBranches() {
      return get(myDocPath()).data.get('deliveryBranches', []);
    }
    // Everyone signed in reads as before; a viewer only reads its own branches.
    function canReadCompany(company) {
      return isStaff() && (!isViewer() || company in viewerCompanies());
    }
    // A viewer never writes anything.
    function canWriteBase() {
      return isStaff() && !isViewer();
    }

    // ---- Expiry "pull requests" lock (Oct 2026) ----
    // When the manager asks someone to pull an item off the shelf, that
    // person's pull_locks/{uid}.n goes up by one. While n > 0 they can't write
    // anything in the app (canWrite() below is false) until they close the
    // request themselves with a proof photo — see expiry_pulls / pull_locks.
    // Enforced here, on the server, so a second phone or a tampered page
    // can't get around it.
    function isLocked() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/pull_locks/$(request.auth.uid))
        && get(/databases/$(database)/documents/pull_locks/$(request.auth.uid)).data.get('n', 0) > 0;
    }
    function canWrite() {
      return canWriteBase() && !isLocked();
    }

    // ---------------- users ----------------
    // Unchanged. (Note: the catch-all at the bottom still also covers /users,
    // exactly as before — see the note there.)
    match /users/{userId} {
      // Reading the list stays open to signed-in staff through the catch-all
      // below (supervisors pick the incoming supervisor from it). Writing is
      // only here (Oct 2026): before, the catch-all also let any employee
      // rewrite any account, including their own role.
      // Own account always (even while waiting for approval); everyone else's only for approved,
      // non-viewer staff (names and roles are needed to pick people). Emails are NOT in this
      // document any more: they live in user_private (manager only).
      allow read: if isOwner(userId) || isAdmin() || (isStaff() && !isViewer());
      allow create: if isManager()
                    // Self-registration: only as a supervisor/merchandiser, always waiting for approval.
                    || (isOwner(userId)
                        && request.resource.data.role in ['supervisor', 'merchandiser']
                        && request.resource.data.get('approved', true) == false
                        && !('email' in request.resource.data));
      allow update: if isManager()
                    || (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['role', 'disabled', 'companies', 'deliveryBranches', 'company', 'department', 'approved', 'email']))
                    // Old username accounts: on first sign-in the new account marks
                    // its old profile as migrated, and nothing else.
                    || (isSignedIn()
                        && !('migratedToUid' in resource.data)
                        && request.resource.data.migratedToUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['migratedToUid']));
      allow delete: if isManager();
    }

    // ---------------- user_private (Nov 2026) ----------------
    // Each account's email, kept apart from users/{uid} so ordinary staff can't read it.
    match /user_private/{uid} {
      allow read: if isManager() || isOwner(uid);
      allow create: if isManager()
                    || (isOwner(uid)
                        && request.resource.data.keys().hasOnly(['email'])
                        && request.resource.data.email is string
                        && request.resource.data.email.lower() == request.auth.token.email.lower());
      allow update, delete: if isManager();
    }

    // ---------------- fcm_tokens (Nov 2026) ----------------
    // A phone's notification address. Staff can only register it under their OWN id and real role,
    // so nobody can sign a device up for the manager's alerts. Only the manager reads the list.
    match /fcm_tokens/{id} {
      allow read: if isManager();
      allow create, update: if canWriteBase()
                            && request.resource.data.userId == request.auth.uid
                            && request.resource.data.role == myRole();
      allow delete: if isManager() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------------- handovers / merch_visits / quick_shortages ----------------
    match /handovers/{docId} {
      allow read: if canReadCompany(resource.data.company);
      // Staff add handovers; only the manager reviews (edits) or deletes them.
      allow create: if canWrite();
      allow update, delete: if isManager();
    }
    match /merch_visits/{docId} {
      allow read: if canReadCompany(resource.data.company);
      allow write: if canWrite();
    }
    match /quick_shortages/{docId} {
      allow read: if canReadCompany(resource.data.company);
      allow write: if canWrite();
    }

    // ---------------- handover_sessions ----------------
    // Backs the dual-presence confirmation gate in Floor Link: before a
    // "handover" entry can be filled in, the outgoing supervisor starts a
    // session and the incoming supervisor must join it within 15 minutes,
    // from a DIFFERENT account. These rules are what actually make that
    // real instead of just a client-side courtesy — a tampered client
    // cannot fake either side of it.
    match /handover_sessions/{id} {
      allow read: if isStaff() && !isViewer();

      // Starting a session: the creator can only name THEMSELVES as the
      // outgoing supervisor (no starting one "as" a colleague), and the
      // incoming side must start empty.
      allow create: if isStaff()
                    && request.resource.data.outgoing.userId == request.auth.uid
                    && request.resource.data.incoming == null
                    && request.resource.data.status == 'awaiting_incoming';

      // Joining: only the still-empty "incoming" side may be filled in, by
      // someone who is NOT the outgoing supervisor, and only while the
      // session is still awaiting_incoming. The outgoing side can never be
      // edited after creation, so a session can't be quietly reassigned to
      // a different "outgoing" person after the fact either.
      allow update: if isStaff()
                    && resource.data.status == 'awaiting_incoming'
                    && request.resource.data.outgoing == resource.data.outgoing
                    && request.resource.data.incoming.userId == request.auth.uid
                    && request.resource.data.incoming.userId != resource.data.outgoing.userId
                    && request.resource.data.status == 'confirmed';

      // Either participant can delete: covers both the 15-minute expiry
      // wipe and the normal cleanup once a handover is actually submitted.
      allow delete: if isStaff()
                    && (resource.data.outgoing.userId == request.auth.uid
                        || (resource.data.incoming != null && resource.data.incoming.userId == request.auth.uid));
    }

    // ---------------- handover_drafts ----------------
    // Once the dual-presence gate above is cleared, the outgoing and
    // incoming supervisor fill in the rest of the handover from their OWN,
    // SEPARATE phones at the same time (checkpoint photos, their own
    // checklist, their own signature). This document is what makes that
    // actually show up on the other person's screen in real time, instead
    // of each phone only knowing about what it captured itself.
    //
    // The id is the same id as the handover_sessions document it belongs
    // to. Every field lives under "draft", split into two fixed groups —
    // which group a field is in is NOT just a UI convention, it's enforced
    // here: the outgoing supervisor's account can only ever write the
    // outgoing-owned fields, and the incoming supervisor's account can only
    // ever write the incoming-owned fields. This is the same anti-collusion
    // guarantee the required-photo split was always meant to have — a
    // tampered client still can't let one side quietly fill in the other's
    // checkpoints or signature.
    match /handover_drafts/{sessionId} {
      allow read: if isStaff() && !isViewer();

      // Created empty (no "draft" field yet) by whichever of the two
      // participants' devices gets there first — both send the identical
      // company/outgoingUserId/incomingUserId, so it doesn't matter which
      // one actually wins the race.
      allow create: if isStaff()
                    && request.resource.data.keys().hasOnly(['company','outgoingUserId','incomingUserId'])
                    && request.resource.data.outgoingUserId is string
                    && request.resource.data.incomingUserId is string
                    && request.auth.uid in [request.resource.data.outgoingUserId, request.resource.data.incomingUserId];

      // Field ownership within "draft":
      //  - requiredPhotosOut / requiredNotesOut / outgoingSig / ackOut:
      //    outgoing-only — this is the anti-collusion guarantee.
      //  - requiredPhotosIn / requiredNotesIn / incomingSig / ackIn:
      //    incoming-only — same guarantee, other side.
      //  - cash / inventory / cleanliness / pending / staffNotes /
      //    closingCheck / date / time: descriptive shift-report content,
      //    not evidence of either person's presence, so either participant
      //    may write these (last write wins, same as a shared notes field
      //    always behaved before this device ever had its own copy).
      allow update: if isStaff()
                    && (request.auth.uid == resource.data.outgoingUserId || request.auth.uid == resource.data.incomingUserId)
                    // The identity fields are permanent — only "draft" ever changes.
                    && request.resource.data.company == resource.data.company
                    && request.resource.data.outgoingUserId == resource.data.outgoingUserId
                    && request.resource.data.incomingUserId == resource.data.incomingUserId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['draft'])
                    && (
                         (request.auth.uid == resource.data.outgoingUserId &&
                          request.resource.data.draft.diff(resource.data.get('draft', {})).affectedKeys()
                            .hasOnly(['requiredPhotosOut','requiredNotesOut','outgoingSig','ackOut','cash','inventory','cleanliness','pending','staffNotes','closingCheck','date','time']))
                         ||
                         (request.auth.uid == resource.data.incomingUserId &&
                          request.resource.data.draft.diff(resource.data.get('draft', {})).affectedKeys()
                            .hasOnly(['requiredPhotosIn','requiredNotesIn','incomingSig','ackIn','counterCheck','cash','inventory','cleanliness','pending','staffNotes','closingCheck','date','time']))
                       );

      // Either participant can delete — cleanup once the handover is
      // actually submitted, or if it's abandoned before that.
      allow delete: if isStaff()
                    && (resource.data.outgoingUserId == request.auth.uid || resource.data.incomingUserId == request.auth.uid);
    }

    // ---------------- expiry_items ----------------
    // Any signed-in employee can read, create, and make ordinary edits
    // (quantity, category). Only a manager can touch the two fields that
    // remove an item from view: "status" and "deletedInfo". A viewer only
    // reads its own branches.
    match /expiry_items/{itemId} {
      allow read: if canReadCompany(resource.data.company);

      allow create: if canWrite()
                    && request.resource.data.createdBy.userId == request.auth.uid
                    && request.resource.data.status == 'active';

      allow update: if isManager()
                    || (canWrite()
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['status', 'deletedInfo', 'deleteRequest', 'deleteRequestPending']))
                    // A supervisor can ASK for an item to be deleted (reason + their
                    // own name), once; only a manager approves (deletes) or rejects it.
                    || (canWrite() && myRole() == 'supervisor'
                        && canReadCompany(resource.data.company)
                        && !('deleteRequest' in resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['deleteRequest', 'deleteRequestPending', 'history'])
                        && request.resource.data.deleteRequest.by.userId == request.auth.uid
                        && request.resource.data.deleteRequest.reason in ['sold', 'gone', 'mistake', 'discount', 'returned', 'other']
                        && request.resource.data.deleteRequest.at is string
                        && request.resource.data.deleteRequestPending == true);

      allow delete: if isManager();
    }

    // ---------------- expiry_pulls / pull_locks (Oct 2026) ----------------
    // The manager asks a merchandiser to pull an item off the shelf/display.
    //  - expiry_pulls/{id}: the request. Only a manager creates or cancels it.
    //    The person it is assigned to can do ONE thing: move it from 'open'
    //    to 'done', with at least one proof photo, their own name and the
    //    server's clock. Only a manager deletes a request, and only once it is no longer open.
    //  - pull_locks/{uid}: {n: open requests, lastClosedPull}. n > 0 locks
    //    that person's writes everywhere else (see isLocked()). The person can
    //    only lower n by exactly one, in the SAME batch that marks one of their
    //    own open requests 'done' (getAfter checks that).
    function pullPath(id) {
      return /databases/$(database)/documents/expiry_pulls/$(id);
    }
    match /expiry_pulls/{id} {
      allow read: if canReadCompany(resource.data.company);
      allow create: if isManager()
                    && request.resource.data.status == 'open'
                    && request.resource.data.createdBy.userId == request.auth.uid
                    && request.resource.data.assigneeId is string
                    // Only a merchandiser (or supervisor) can be asked to pull
                    // something — never a manager, who would otherwise end up
                    // locked out of the app by their own request.
                    && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeId)).data.get('role', '') in ['merchandiser', 'supervisor']
                    && request.resource.data.createdAt == request.time;
      allow update: if isManager()
                    || (isOwner(resource.data.assigneeId)
                        && resource.data.status == 'open'
                        && request.resource.data.status == 'done'
                        && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['status', 'proofs', 'doneAt', 'doneBy'])
                        && request.resource.data.proofs is list
                        && request.resource.data.proofs.size() >= 1
                        && request.resource.data.proofs[0].id is string
                        && request.resource.data.doneBy.userId == request.auth.uid
                        && request.resource.data.doneAt == request.time);
      // The manager can tidy up finished requests; an open one must be
      // cancelled first so the assignee's lock count stays correct.
      allow delete: if isManager() && resource.data.status != 'open';
    }
    match /pull_locks/{uid} {
      allow read: if isOwner(uid) || isManager();
      allow create, update: if isManager();
      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n', 'lastClosedPull'])
                    && request.resource.data.lastClosedPull is string
                    && request.resource.data.n == resource.data.n - 1
                    && request.resource.data.n >= 0
                    && get(pullPath(request.resource.data.lastClosedPull)).data.status == 'open'
                    && get(pullPath(request.resource.data.lastClosedPull)).data.assigneeId == uid
                    && getAfter(pullPath(request.resource.data.lastClosedPull)).data.status == 'done';
      allow delete: if false;
    }

    // ---------------- delivery_shifts ----------------
    // Written by the branch delivery books. Read by managers, by the delivery
    // books themselves, and by a viewer for the delivery books ticked on its account.
    // ---------------- account_deletions (Oct 2026) ----------------
    // The manager deleting an account in the app leaves a note here; the scheduled
    // sync-roles job then deletes the Firebase Auth account too (frees the email).
    match /account_deletions/{uid} {
      allow create: if isManager();
      allow read, update, delete: if isManager();
    }

    // ---------------- voice_messages (Oct 2026) ----------------
    // One-way voice broadcasts from the manager. recipientIds is worked out when it is
    // sent; each recipient may only mark their OWN entry in `listened` (heard receipt).
    match /voice_messages/{id} {
      allow read: if isManager()
                  || (isStaff() && request.auth.uid in resource.data.recipientIds);
      allow create: if isManager()
                    && request.resource.data.from.userId == request.auth.uid
                    && request.resource.data.recipientIds is list
                    && request.resource.data.recipientIds.size() <= 200;
      allow update: if isStaff()
                    && request.auth.uid in resource.data.recipientIds
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['listened'])
                    && request.resource.data.listened.diff(resource.data.listened).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if isManager();
    }

    match /delivery_shifts/{docId} {
      allow read: if isManager()
                  || (isStaff() && myRole() == 'delivery')
                  || (isViewer() && resource.data.branch in viewerDeliveryBranches());
      // Written by the delivery book's account (role delivery); the manager can fix entries.
      allow write: if isManager() || (canWrite() && myRole() == 'delivery');
    }

    // ---------------- attendance (Oct 2026) ----------------
    // Written only by the shop's fingerprint computer (service account, which
    // bypasses these rules). Only the owner reads for now; nobody writes from
    // the app. Keep this list in sync with ATT_OWNERS in index.html.
    function isAttendanceOwner() {
      return isSignedIn() && request.auth.token.email in ['tarek.hajjomar@gmail.com'];
    }
    match /attendance_days/{day} {
      allow read: if isAttendanceOwner();
      allow write: if false;
    }
    match /attendance_reports/{month} {
      allow read: if isAttendanceOwner();
      allow write: if false;
    }

    // ---------------- activity_log ----------------
    // Unchanged. Append-only; only admins read it.
    match /activity_log/{logId} {
      allow create: if isStaff()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // =====================================================================
    // ---------------- CUSTOMER FEEDBACK ----------------
    // =====================================================================
    function fbIsAnon() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // ----- QR codes (made from Floor Link, admin only) -----
    // feedback_codes/{codeId}: branch, type, place, active, createdAt, createdBy
    // type: 'store', 'delivery', or 'any' (the customer picks store or delivery on the page)
    match /feedback_codes/{codeId} {
      allow get: if true;          // the customer page reads its one code (branch + type)
      allow list: if isManager();    // only the admin sees the list of codes
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['branch', 'type', 'place', 'active', 'createdAt', 'createdBy'])
        && request.resource.data.branch in ['shoppies', 'omar_mina', 'omar_abrin']
        && request.resource.data.type in ['delivery', 'store', 'any']
        && request.resource.data.place is string
        && request.resource.data.place.size() >= 1
        && request.resource.data.place.size() <= 60
        && request.resource.data.active is bool;
      allow delete: if isManager();
    }

    // ----- feedback sent by customers -----
    function fbCodeOk(d) {
      let c = /databases/$(database)/documents/feedback_codes/$(d.codeId);
      return exists(c)
        && get(c).data.active == true
        && get(c).data.branch == d.branch
        && (get(c).data.type == d.type || get(c).data.type == 'any');
    }
    function fbAnswersOk(d) {
      return d.answers is map
        && d.answers.values().toSet().hasOnly(['good', 'ok', 'bad'])
        && ((d.type == 'delivery' && d.answers.keys().hasOnly(['speed', 'driver', 'order']))
          || (d.type == 'store' && d.answers.keys().hasOnly(['clean', 'stock', 'staff'])));
    }
    function fbReviewOk(d) {
      return d.stars is int && d.stars >= 1 && d.stars <= 5
        && fbAnswersOk(d)
        && !d.keys().hasAny(['wantsContact', 'contactName', 'contactInfo']);
    }
    function fbComplaintOk(d) {
      return d.text.size() >= 2
        && !d.keys().hasAny(['stars', 'answers'])
        && d.wantsContact is bool
        && ((d.wantsContact == false && !d.keys().hasAny(['contactName', 'contactInfo']))
          || (d.wantsContact == true
            && d.contactName is string && d.contactName.size() <= 80
            && d.contactInfo is string && d.contactInfo.size() >= 3 && d.contactInfo.size() <= 80));
    }
    function fbNewOk(d) {
      return d.keys().hasAll(['codeId', 'branch', 'type', 'kind', 'text', 'lang', 'uid', 'handled', 'createdAt'])
        && d.keys().hasOnly(['codeId', 'branch', 'type', 'kind', 'stars', 'answers', 'text',
                             'wantsContact', 'contactName', 'contactInfo', 'lang', 'uid', 'handled', 'createdAt'])
        && d.uid == request.auth.uid
        && d.createdAt == request.time
        && d.handled == false
        && d.codeId is string && d.codeId.size() <= 40
        && d.text is string && d.text.size() <= 1000
        && d.lang in ['ar', 'en']
        && ((d.kind == 'review' && fbReviewOk(d)) || (d.kind == 'complaint' && fbComplaintOk(d)));
    }
    // every send must also stamp the device's rate counter in the same batch
    function fbRateStamped() {
      return getAfter(/databases/$(database)/documents/feedback_rate/$(request.auth.uid)).data.lastAt == request.time;
    }

    match /feedback/{id} {
      allow create: if fbIsAnon()
        && fbNewOk(request.resource.data)
        && fbCodeOk(request.resource.data)
        && fbRateStamped();
      allow read: if isManager();
      // the admin can only mark a complaint as handled; nothing else changes
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled', 'handledAt', 'handledBy'])
        && request.resource.data.handled is bool;
      allow delete: if isManager();
    }

    // ----- spam limit, per device -----
    // at most 1 send per 60 seconds, and at most 5 sends per 24 hours
    match /feedback_rate/{uid} {
      allow get: if fbIsAnon() && request.auth.uid == uid;
      allow create: if fbIsAnon() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt', 'windowStart', 'n'])
        && request.resource.data.lastAt == request.time
        && request.resource.data.windowStart == request.time
        && request.resource.data.n == 1;
      allow update: if fbIsAnon() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt', 'windowStart', 'n'])
        && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(60, 's')
        && ((request.time < resource.data.windowStart + duration.value(24, 'h')
              && request.resource.data.windowStart == resource.data.windowStart
              && request.resource.data.n == resource.data.n + 1
              && request.resource.data.n <= 5)
          || (request.time >= resource.data.windowStart + duration.value(24, 'h')
              && request.resource.data.windowStart == request.time
              && request.resource.data.n == 1));
    }

    // ---------------- catalog / settings (Nov 2026) ----------------
    // Reading stays with the catch-all below. Any staff adds or fixes a catalog product
    // (scanning), but only the manager deletes one or changes the settings.
    match /catalog/{id} {
      allow create, update: if canWrite();
      allow delete: if isManager();
    }
    match /settings/{id} {
      allow write: if isManager();
    }

    // ---------------- Kitchen OS (Nov 2026) ----------------
    // Shoppies central kitchen. Separate app (floorlink-app/kitchen-os), same login.
    // Everything lives in collections named kitchen_*. Access comes ONLY from
    // kitchen_members/{uid}.role — never from the Floor Link role — so Floor Link staff
    // see nothing here unless the owner gives them a kitchen role.
    //   owner      : everything; the only one who approves recipes (and later prices)
    //   manager    : kitchen manager — like chef, plus manages ingredients/categories
    //   chef       : proposes recipes, quality checks
    //   cook       : reads approved recipes only
    //   receiving  : (phase 2) deliveries
    //   accountant : (phase 3) expenses
    function kPath() {
      return /databases/$(database)/documents/kitchen_members/$(request.auth.uid);
    }
    function kRole() {
      return (request.auth != null && exists(kPath()) && get(kPath()).data.get('active', true) != false)
        ? get(kPath()).data.get('role', '') : '';
    }
    function kIn(roles) {
      return isSignedIn() && kRole() in roles;
    }
    function kOwner() { return kIn(['owner']); }
    function kAny() { return kIn(['owner', 'manager', 'chef', 'cook', 'receiving', 'accountant']); }
    function kAuthor() { return kIn(['owner', 'manager', 'chef']); }
    function kRecipeReader() { return kIn(['owner', 'manager', 'chef', 'cook']); }
    // Kitchen sections (chicken / cooking): a chef or cook with a section only reaches that section.
    // Owner, manager and anyone without a section reach all sections.
    function kSec() { return (request.auth != null && exists(kPath())) ? get(kPath()).data.get('section', null) : null; }
    function kSecOk(s) { return kIn(['owner', 'manager']) || kSec() == null || s == kSec(); }
    function kRecipeSec(rid) { return get(/databases/$(database)/documents/kitchen_recipes/$(rid)).data.get('section', null); }

    match /kitchen_members/{uid} {
      // Floor Link admin bootstraps the first owner; after that the kitchen owner manages the team.
      allow read: if isOwner(uid) || isAdmin() || kIn(['owner', 'manager']);
      allow create, update: if isAdmin() || kOwner();
      allow delete: if isAdmin() || kOwner();
    }

    // Categories, units, settings for the kitchen.
    match /kitchen_settings/{id} {
      allow read: if kAny();
      allow write: if kIn(['owner', 'manager']);
    }

    match /kitchen_ingredients/{id} {
      allow read: if kAny();
      allow create, update: if kAuthor();
      allow delete: if kOwner();
    }

    // A recipe card. officialVersion (the approved standard) is set by the owner only.
    match /kitchen_recipes/{rid} {
      allow read: if kRecipeReader() && kSecOk(resource.data.get('section', null));
      allow create: if kAuthor()
                    && request.resource.data.get('officialVersion', null) == null
                    && kSecOk(request.resource.data.get('section', null));
      allow update: if kOwner()
                    || (kAuthor()
                        && kSecOk(resource.data.get('section', null))
                        && kSecOk(request.resource.data.get('section', null))
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['officialVersion', 'approvedAt', 'approvedBy']));
      allow delete: if kOwner();

      // Every version is kept. Statuses: draft → proposed → approved | rejected; an approved
      // version becomes archived when a newer one is approved. Only the owner approves/rejects,
      // and the content of an approved/archived version can never change again.
      match /versions/{vid} {
        allow read: if (kIn(['owner', 'manager', 'chef'])
                    || (kRecipeReader() && resource.data.status in ['approved', 'archived']))
                    && kSecOk(kRecipeSec(rid));
        allow create: if kAuthor() && kSecOk(kRecipeSec(rid))
                      && request.resource.data.status in ['draft', 'proposed']
                      && request.resource.data.proposedBy == request.auth.uid;
        allow update: if
             // the author (or owner/manager) keeps editing a draft/proposal
             (kAuthor() && kSecOk(kRecipeSec(rid))
               && resource.data.status in ['draft', 'proposed']
               && request.resource.data.status in ['draft', 'proposed']
               && (resource.data.proposedBy == request.auth.uid || kIn(['owner', 'manager']))
               && request.resource.data.proposedBy == resource.data.proposedBy)
             // the owner decides on a proposal
          || (kOwner()
               && resource.data.status in ['draft', 'proposed']
               && request.resource.data.status in ['approved', 'rejected'])
             // the owner archives the previous official version — status fields only
          || (kOwner()
               && resource.data.status == 'approved'
               && request.resource.data.status == 'archived'
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'archivedAt', 'archivedBy']));
        allow delete: if (kAuthor() && resource.data.status == 'draft'
                          && resource.data.proposedBy == request.auth.uid)
                      || (kOwner() && resource.data.status in ['draft', 'proposed', 'rejected']);
      }
    }

    // Purchase price per kg / l / piece of an ingredient or supply. Chefs and cooks never see prices.
    match /kitchen_costs/{id} {
      allow read: if kIn(['owner', 'manager', 'accountant']);
      allow write: if kIn(['owner', 'manager']);
    }

    // Cleaning log: weight before and after cleaning (chicken, meat…). Kitchen staff add
    // entries in their own name; only the owner can correct or remove one.
    match /kitchen_cleaning/{id} {
      allow read: if kIn(['owner', 'manager', 'chef']);
      allow create: if kIn(['owner', 'manager', 'chef', 'cook'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.before is number && request.resource.data.before > 0
                    && request.resource.data.after is number && request.resource.data.after > 0
                    && request.resource.data.after <= request.resource.data.before;
      allow update, delete: if kOwner();
    }

    // Selling price and target margin of a product. Only the owner decides prices.
    match /kitchen_pricing/{rid} {
      allow read: if kIn(['owner', 'accountant']);
      allow write: if kOwner();
    }

    // ---- Phase 2: receiving, quality control, stock (Nov 2026)
    function kStock() { return kIn(['owner', 'manager', 'chef', 'receiving']); }

    match /kitchen_suppliers/{id} {
      allow read: if kStock();
      allow write: if kIn(['owner', 'manager', 'receiving']);
    }

    // A delivery: the receiving employee records it (awaiting_qc); the chef checks quality
    // and closes it (done). Once done it can no longer be changed.
    match /kitchen_deliveries/{id} {
      allow read: if kStock();
      allow create: if kIn(['owner', 'manager', 'receiving'])
                    && request.resource.data.status == 'awaiting_qc'
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if resource.data.status == 'awaiting_qc' && (
             (kIn(['owner', 'manager', 'receiving']) && request.resource.data.status == 'awaiting_qc'
               && request.resource.data.createdBy == resource.data.createdBy)
          || (kIn(['owner', 'manager', 'chef']) && request.resource.data.status == 'done'
               && request.resource.data.qcBy == request.auth.uid));
      allow delete: if kOwner() && resource.data.status == 'awaiting_qc';
    }

    // A batch of stock. Created once by the quality check (accepted quantity only; the id is
    // fixed per delivery line, so the same line can never be counted twice).
    // The chef can put a batch on hold; only owner/manager release, discard or correct it.
    match /kitchen_batches/{id} {
      allow read: if kIn(['owner', 'manager', 'chef', 'cook', 'receiving']);
      // Cooks may only create the batch that comes out of a production.
      allow create: if (kIn(['owner', 'manager', 'chef']) || (kIn(['cook']) && request.resource.data.productionId is string))
                    && request.resource.data.status == 'available'
                    && request.resource.data.qty is number && request.resource.data.qty > 0
                    && request.resource.data.remaining == request.resource.data.qty;
      // Chef/cook may only LOWER what is left of an available batch (used in production or wasted).
      allow update: if kIn(['owner', 'manager'])
                    || (kIn(['chef']) && resource.data.status == 'available'
                        && request.resource.data.status == 'hold'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'holdReason', 'holdBy', 'holdByName', 'holdAt']))
                    || (kIn(['chef', 'cook']) && resource.data.status == 'available'
                        && request.resource.data.remaining is number
                        && request.resource.data.remaining >= 0 && request.resource.data.remaining < resource.data.remaining
                        && request.resource.data.lastUsedBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remaining', 'lastUsedAt', 'lastUsedBy']));
      allow delete: if false;
    }

    // Stock movements log (receive, hold, release, discard, correction). Append-only.
    match /kitchen_movements/{id} {
      allow read: if kIn(['owner', 'manager']);
      allow create: if kAny() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Food safety & equipment
    // Equipment and its temperature limits: only owner/manager. Units are switched off, never deleted.
    match /kitchen_equipment/{id} {
      allow read: if kIn(['owner', 'manager', 'chef', 'cook', 'receiving']);
      allow create, update: if kIn(['owner', 'manager']);
      allow delete: if false;
    }
    // Temperature readings. Append-only: a reading is never changed afterwards.
    match /kitchen_temps/{id} {
      allow read: if kIn(['owner', 'manager', 'chef', 'cook']);
      allow create: if kIn(['owner', 'manager', 'chef', 'cook']) && request.resource.data.by == request.auth.uid
                    && request.resource.data.temp is number;
      allow update, delete: if false;
    }
    // Hygiene checklist ticks: one document per task per day (id date_task) — ticked once, never un-ticked.
    match /kitchen_checks/{id} {
      allow read: if kIn(['owner', 'manager', 'chef', 'cook']);
      allow create: if kIn(['owner', 'manager', 'chef', 'cook']) && request.resource.data.by == request.auth.uid
                    && id == request.resource.data.date + '_' + request.resource.data.taskId;
      allow update, delete: if false;
    }
    // Equipment faults (anyone in the kitchen reports) and service records (owner/manager). Only owner/manager close a fault.
    match /kitchen_issues/{id} {
      allow read: if kIn(['owner', 'manager', 'chef', 'cook', 'receiving']);
      allow create: if request.resource.data.reportedBy == request.auth.uid && (
             (kIn(['owner', 'manager', 'chef', 'cook', 'receiving']) && request.resource.data.kind == 'fault' && request.resource.data.status == 'open')
          || (kIn(['owner', 'manager']) && request.resource.data.kind == 'service' && request.resource.data.status == 'fixed'));
      allow update: if kIn(['owner', 'manager']) && resource.data.status == 'open'
                    && request.resource.data.status == 'fixed' && request.resource.data.fixedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'fixNote', 'fixedBy', 'fixedByName', 'fixedAt']);
      allow delete: if false;
    }

    // Daily production plan (one document per day, id = YYYY-MM-DD).
    // One plan per section per day (id <date>_<section>).
    match /kitchen_plans/{day} {
      allow read: if kIn(['owner', 'manager', 'chef', 'cook']) && kSecOk(resource.data.get('section', null));
      allow create: if kIn(['owner', 'manager', 'chef']) && request.resource.data.updatedBy == request.auth.uid
                    && kSecOk(request.resource.data.get('section', null));
      allow update: if kIn(['owner', 'manager', 'chef']) && request.resource.data.updatedBy == request.auth.uid
                    && kSecOk(resource.data.get('section', null)) && kSecOk(request.resource.data.get('section', null));
      allow delete: if false;
    }

    // What was produced and what it took from stock. Append-only.
    match /kitchen_production/{id} {
      allow read: if kIn(['owner', 'manager', 'chef', 'cook']) && kSecOk(resource.data.get('section', null));
      allow create: if kIn(['owner', 'manager', 'chef', 'cook']) && request.resource.data.by == request.auth.uid
                    && kSecOk(request.resource.data.get('section', null));
      allow update, delete: if false;
    }

    // Waste log. Cooks can log waste but not read the report. Append-only.
    match /kitchen_waste/{id} {
      allow read: if kIn(['owner', 'manager', 'chef', 'accountant']);
      allow create: if kIn(['owner', 'manager', 'chef', 'cook']) && request.resource.data.by == request.auth.uid
                    && request.resource.data.qty is number && request.resource.data.qty >= 0;
      allow update, delete: if false;
    }

    // Supplier claim: opened by the quality check (rejected part) or by returning a batch.
    // Only owner/manager close it, and a closed claim never changes again.
    match /kitchen_claims/{id} {
      allow read: if kIn(['owner', 'manager', 'chef', 'receiving', 'accountant']);
      allow create: if kIn(['owner', 'manager', 'chef'])
                    && request.resource.data.status == 'open'
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if kIn(['owner', 'manager']) && resource.data.status == 'open'
                    && request.resource.data.status in ['replaced', 'refunded', 'dropped']
                    && request.resource.data.closedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closeNote', 'closedBy', 'closedByName', 'closedAt']);
      allow delete: if false;
    }

    // Purchase request: the kitchen asks; owner/manager mark it ordered/arrived/cancelled.
    // Receiving can mark an ordered request as arrived; the requester can cancel a new one.
    // The items of a request never change after it is sent.
    function kReqKeys(st) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', st + 'By', st + 'ByName', st + 'At']);
    }
    match /kitchen_requests/{id} {
      allow read: if kIn(['owner', 'manager', 'chef', 'receiving']);
      allow create: if kIn(['owner', 'manager', 'chef'])
                    && request.resource.data.status == 'requested'
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if kReqKeys(request.resource.data.status) && (
             (kIn(['owner', 'manager']) && resource.data.status in ['requested', 'ordered']
               && request.resource.data.status in ['ordered', 'received', 'cancelled'])
          || (kIn(['receiving']) && resource.data.status == 'ordered' && request.resource.data.status == 'received')
          || (resource.data.createdBy == request.auth.uid && kIn(['chef'])
               && resource.data.status == 'requested' && request.resource.data.status == 'cancelled'));
      allow delete: if false;
    }

    // Stock count: chef/manager/owner send it; only owner/manager apply or reject it, once.
    match /kitchen_counts/{id} {
      allow read: if kIn(['owner', 'manager', 'chef']);
      allow create: if kIn(['owner', 'manager', 'chef'])
                    && request.resource.data.status == 'submitted'
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if kIn(['owner', 'manager']) && resource.data.status == 'submitted'
                    && request.resource.data.status in ['applied', 'rejected']
                    && request.resource.data.decidedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedByName', 'decidedAt']);
      allow delete: if false;
    }

    // Who did what and when. Append-only: nobody edits or deletes.
    match /kitchen_audit/{id} {
      allow read: if kOwner();
      allow create: if kAny() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // Any other kitchen_* collection stays closed: the catch-all below skips kitchen_*.

    // ---------------- everything else ----------------
    // Same open-to-signed-in behavior as before for every other collection
    // (catalog, settings, fcm_tokens, users, activity_log, ...), EXCEPT:
    //  - the five collections above are left to their own rules (previously
    //    this catch-all also matched them and overrode their limits), and
    //  - a viewer can only read catalog and settings here, and can't write.
    //  - the three customer-feedback collections are left to their own rules
    //    too, so only managers read feedback (not supervisors).
    //  - account documents (users) are only written through their own rules (Oct 2026).
    match /{collection}/{document=**} {
      allow read: if isStaff()
                  && !collection.matches('kitchen_.*')
                  && !(collection in ['handovers', 'handover_sessions', 'handover_drafts', 'attendance_days', 'attendance_reports', 'merch_visits', 'quick_shortages', 'expiry_items', 'expiry_pulls', 'pull_locks', 'delivery_shifts', 'feedback', 'feedback_codes', 'feedback_rate', 'voice_messages', 'account_deletions', 'users', 'user_private', 'fcm_tokens', 'activity_log'])
                  && (!isViewer() || collection in ['catalog', 'settings']);
      // fcm_tokens stays writable while someone is locked: a locked person
      // still has to keep receiving the reminder notifications.
      allow write: if canWrite()
                   && !collection.matches('kitchen_.*')
                   && !(collection in ['handovers', 'handover_sessions', 'handover_drafts', 'attendance_days', 'attendance_reports', 'merch_visits', 'quick_shortages', 'expiry_items', 'expiry_pulls', 'pull_locks', 'delivery_shifts', 'feedback', 'feedback_codes', 'feedback_rate', 'voice_messages', 'account_deletions', 'users', 'user_private', 'fcm_tokens', 'activity_log', 'catalog', 'settings']);
    }
  }
}
