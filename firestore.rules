rules_version = '2';

// Floor Link — role-based Firestore rules (Firebase Auth + Custom Claims).
//
// The "role" claim is set by a scheduled GitHub Action (scripts/sync-roles.js)
// from the "role" field on each /users/{uid} document, with a few minutes'
// delay. The read-only "viewer" role is checked from the /users document
// directly (not the claim), so a new viewer is limited from their very first
// sign-in, and the branches they may see come from that same document:
//   companies:        ["omar_mina", "omar_abrin", ...]   (handover, merch, expiry, shortages)
//   deliveryBranches: ["<branch name exactly as the delivery book writes it>", ...]
// The manager ticks both lists in the app's Accounts screen.
//
// Customer feedback (Oct 2026): feedback_codes (QR codes), feedback (replies),
// feedback_rate (spam limit per device). Only managers read feedback.

service cloud.firestore {
  match /databases/{database}/documents {

    // Customers on the public feedback page sign in ANONYMOUSLY. They never
    // count as signed-in employees; they can only send feedback (see below).
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function myDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function myRole() {
      return exists(myDocPath()) ? get(myDocPath()).data.get('role', '') : '';
    }
    function isViewer() {
      return isSignedIn() && myRole() == 'viewer';
    }
    // Manager by claim, or by the users document (covers older "manager" accounts
    // and the minutes before the claim sync runs).
    function isManager() {
      return isAdmin() || (isSignedIn() && myRole() in ['admin', 'manager']);
    }
    function viewerCompanies() {
      return get(myDocPath()).data.get('companies', []);
    }
    function viewerDeliveryBranches() {
      return get(myDocPath()).data.get('deliveryBranches', []);
    }
    // Everyone signed in reads as before; a viewer only reads its own branches.
    function canReadCompany(company) {
      return isSignedIn() && (!isViewer() || company in viewerCompanies());
    }
    // A viewer never writes anything.
    function canWriteBase() {
      return isSignedIn() && !isViewer();
    }

    // ---- Expiry "pull requests" lock (Oct 2026) ----
    // When the manager asks someone to pull an item off the shelf, that
    // person's pull_locks/{uid}.n goes up by one. While n > 0 they can't write
    // anything in the app (canWrite() below is false) until they close the
    // request themselves with a proof photo — see expiry_pulls / pull_locks.
    // Enforced here, on the server, so a second phone or a tampered page
    // can't get around it.
    function isLocked() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/pull_locks/$(request.auth.uid))
        && get(/databases/$(database)/documents/pull_locks/$(request.auth.uid)).data.get('n', 0) > 0;
    }
    function canWrite() {
      return canWriteBase() && !isLocked();
    }

    // ---------------- users ----------------
    // Unchanged. (Note: the catch-all at the bottom still also covers /users,
    // exactly as before — see the note there.)
    match /users/{userId} {
      // Reading the list stays open to signed-in staff through the catch-all
      // below (supervisors pick the incoming supervisor from it). Writing is
      // only here (Oct 2026): before, the catch-all also let any employee
      // rewrite any account, including their own role.
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isManager()
                    || (isOwner(userId)
                        && request.resource.data.role in ['supervisor', 'merchandiser']);
      allow update: if isManager()
                    || (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['role', 'disabled', 'companies', 'deliveryBranches', 'company', 'department']))
                    // Old username accounts: on first sign-in the new account marks
                    // its old profile as migrated, and nothing else.
                    || (isSignedIn()
                        && !('migratedToUid' in resource.data)
                        && request.resource.data.migratedToUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['migratedToUid']));
      allow delete: if isManager();
    }

    // ---------------- handovers / merch_visits / quick_shortages ----------------
    match /handovers/{docId} {
      allow read: if canReadCompany(resource.data.company);
      allow write: if canWrite();
    }
    match /merch_visits/{docId} {
      allow read: if canReadCompany(resource.data.company);
      allow write: if canWrite();
    }
    match /quick_shortages/{docId} {
      allow read: if canReadCompany(resource.data.company);
      allow write: if canWrite();
    }

    // ---------------- handover_sessions ----------------
    // Backs the dual-presence confirmation gate in Floor Link: before a
    // "handover" entry can be filled in, the outgoing supervisor starts a
    // session and the incoming supervisor must join it within 15 minutes,
    // from a DIFFERENT account. These rules are what actually make that
    // real instead of just a client-side courtesy — a tampered client
    // cannot fake either side of it.
    match /handover_sessions/{id} {
      allow read: if isSignedIn();

      // Starting a session: the creator can only name THEMSELVES as the
      // outgoing supervisor (no starting one "as" a colleague), and the
      // incoming side must start empty.
      allow create: if isSignedIn()
                    && request.resource.data.outgoing.userId == request.auth.uid
                    && request.resource.data.incoming == null
                    && request.resource.data.status == 'awaiting_incoming';

      // Joining: only the still-empty "incoming" side may be filled in, by
      // someone who is NOT the outgoing supervisor, and only while the
      // session is still awaiting_incoming. The outgoing side can never be
      // edited after creation, so a session can't be quietly reassigned to
      // a different "outgoing" person after the fact either.
      allow update: if isSignedIn()
                    && resource.data.status == 'awaiting_incoming'
                    && request.resource.data.outgoing == resource.data.outgoing
                    && request.resource.data.incoming.userId == request.auth.uid
                    && request.resource.data.incoming.userId != resource.data.outgoing.userId
                    && request.resource.data.status == 'confirmed';

      // Either participant can delete: covers both the 15-minute expiry
      // wipe and the normal cleanup once a handover is actually submitted.
      allow delete: if isSignedIn()
                    && (resource.data.outgoing.userId == request.auth.uid
                        || (resource.data.incoming != null && resource.data.incoming.userId == request.auth.uid));
    }

    // ---------------- handover_drafts ----------------
    // Once the dual-presence gate above is cleared, the outgoing and
    // incoming supervisor fill in the rest of the handover from their OWN,
    // SEPARATE phones at the same time (checkpoint photos, their own
    // checklist, their own signature). This document is what makes that
    // actually show up on the other person's screen in real time, instead
    // of each phone only knowing about what it captured itself.
    //
    // The id is the same id as the handover_sessions document it belongs
    // to. Every field lives under "draft", split into two fixed groups —
    // which group a field is in is NOT just a UI convention, it's enforced
    // here: the outgoing supervisor's account can only ever write the
    // outgoing-owned fields, and the incoming supervisor's account can only
    // ever write the incoming-owned fields. This is the same anti-collusion
    // guarantee the required-photo split was always meant to have — a
    // tampered client still can't let one side quietly fill in the other's
    // checkpoints or signature.
    match /handover_drafts/{sessionId} {
      allow read: if isSignedIn();

      // Created empty (no "draft" field yet) by whichever of the two
      // participants' devices gets there first — both send the identical
      // company/outgoingUserId/incomingUserId, so it doesn't matter which
      // one actually wins the race.
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['company','outgoingUserId','incomingUserId'])
                    && request.resource.data.outgoingUserId is string
                    && request.resource.data.incomingUserId is string
                    && request.auth.uid in [request.resource.data.outgoingUserId, request.resource.data.incomingUserId];

      // Field ownership within "draft":
      //  - requiredPhotosOut / requiredNotesOut / outgoingSig / ackOut:
      //    outgoing-only — this is the anti-collusion guarantee.
      //  - requiredPhotosIn / requiredNotesIn / incomingSig / ackIn:
      //    incoming-only — same guarantee, other side.
      //  - cash / inventory / cleanliness / pending / staffNotes /
      //    closingCheck / date / time: descriptive shift-report content,
      //    not evidence of either person's presence, so either participant
      //    may write these (last write wins, same as a shared notes field
      //    always behaved before this device ever had its own copy).
      allow update: if isSignedIn()
                    && (request.auth.uid == resource.data.outgoingUserId || request.auth.uid == resource.data.incomingUserId)
                    // The identity fields are permanent — only "draft" ever changes.
                    && request.resource.data.company == resource.data.company
                    && request.resource.data.outgoingUserId == resource.data.outgoingUserId
                    && request.resource.data.incomingUserId == resource.data.incomingUserId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['draft'])
                    && (
                         (request.auth.uid == resource.data.outgoingUserId &&
                          request.resource.data.draft.diff(resource.data.get('draft', {})).affectedKeys()
                            .hasOnly(['requiredPhotosOut','requiredNotesOut','outgoingSig','ackOut','cash','inventory','cleanliness','pending','staffNotes','closingCheck','date','time']))
                         ||
                         (request.auth.uid == resource.data.incomingUserId &&
                          request.resource.data.draft.diff(resource.data.get('draft', {})).affectedKeys()
                            .hasOnly(['requiredPhotosIn','requiredNotesIn','incomingSig','ackIn','cash','inventory','cleanliness','pending','staffNotes','closingCheck','date','time']))
                       );

      // Either participant can delete — cleanup once the handover is
      // actually submitted, or if it's abandoned before that.
      allow delete: if isSignedIn()
                    && (resource.data.outgoingUserId == request.auth.uid || resource.data.incomingUserId == request.auth.uid);
    }

    // ---------------- expiry_items ----------------
    // Any signed-in employee can read, create, and make ordinary edits
    // (quantity, category). Only a manager can touch the two fields that
    // remove an item from view: "status" and "deletedInfo". A viewer only
    // reads its own branches.
    match /expiry_items/{itemId} {
      allow read: if canReadCompany(resource.data.company);

      allow create: if canWrite()
                    && request.resource.data.createdBy.userId == request.auth.uid
                    && request.resource.data.status == 'active';

      allow update: if isManager()
                    || (canWrite()
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['status', 'deletedInfo']));

      allow delete: if isManager();
    }

    // ---------------- expiry_pulls / pull_locks (Oct 2026) ----------------
    // The manager asks a merchandiser to pull an item off the shelf/display.
    //  - expiry_pulls/{id}: the request. Only a manager creates or cancels it.
    //    The person it is assigned to can do ONE thing: move it from 'open'
    //    to 'done', with at least one proof photo, their own name and the
    //    server's clock. Nobody deletes a request.
    //  - pull_locks/{uid}: {n: open requests, lastClosedPull}. n > 0 locks
    //    that person's writes everywhere else (see isLocked()). The person can
    //    only lower n by exactly one, in the SAME batch that marks one of their
    //    own open requests 'done' (getAfter checks that).
    function pullPath(id) {
      return /databases/$(database)/documents/expiry_pulls/$(id);
    }
    match /expiry_pulls/{id} {
      allow read: if canReadCompany(resource.data.company);
      allow create: if isManager()
                    && request.resource.data.status == 'open'
                    && request.resource.data.createdBy.userId == request.auth.uid
                    && request.resource.data.assigneeId is string
                    // Only a merchandiser (or supervisor) can be asked to pull
                    // something — never a manager, who would otherwise end up
                    // locked out of the app by their own request.
                    && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeId)).data.get('role', '') in ['merchandiser', 'supervisor']
                    && request.resource.data.createdAt == request.time;
      allow update: if isManager()
                    || (isOwner(resource.data.assigneeId)
                        && resource.data.status == 'open'
                        && request.resource.data.status == 'done'
                        && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['status', 'proofs', 'doneAt', 'doneBy'])
                        && request.resource.data.proofs is list
                        && request.resource.data.proofs.size() >= 1
                        && request.resource.data.proofs[0].id is string
                        && request.resource.data.doneBy.userId == request.auth.uid
                        && request.resource.data.doneAt == request.time);
      allow delete: if false;
    }
    match /pull_locks/{uid} {
      allow read: if isOwner(uid) || isManager();
      allow create, update: if isManager();
      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n', 'lastClosedPull'])
                    && request.resource.data.lastClosedPull is string
                    && request.resource.data.n == resource.data.n - 1
                    && request.resource.data.n >= 0
                    && get(pullPath(request.resource.data.lastClosedPull)).data.status == 'open'
                    && get(pullPath(request.resource.data.lastClosedPull)).data.assigneeId == uid
                    && getAfter(pullPath(request.resource.data.lastClosedPull)).data.status == 'done';
      allow delete: if false;
    }

    // ---------------- delivery_shifts ----------------
    // Written by the branch delivery books. Read by managers, by the delivery
    // books themselves, and by a viewer for the delivery books ticked on its account.
    match /delivery_shifts/{docId} {
      allow read: if isManager()
                  || (isSignedIn() && myRole() == 'delivery')
                  || (isViewer() && resource.data.branch in viewerDeliveryBranches());
      allow write: if canWrite();
    }

    // ---------------- attendance (Oct 2026) ----------------
    // Written only by the shop's fingerprint computer (service account, which
    // bypasses these rules). Only the owner reads for now; nobody writes from
    // the app. Keep this list in sync with ATT_OWNERS in index.html.
    function isAttendanceOwner() {
      return isSignedIn() && request.auth.token.email in ['tarek.hajjomar@gmail.com'];
    }
    match /attendance_days/{day} {
      allow read: if isAttendanceOwner();
      allow write: if false;
    }
    match /attendance_reports/{month} {
      allow read: if isAttendanceOwner();
      allow write: if false;
    }

    // ---------------- activity_log ----------------
    // Unchanged. Append-only; only admins read it.
    match /activity_log/{logId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // =====================================================================
    // ---------------- CUSTOMER FEEDBACK ----------------
    // =====================================================================
    function fbIsAnon() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // ----- QR codes (made from Floor Link, admin only) -----
    // feedback_codes/{codeId}: branch, type, place, active, createdAt, createdBy
    // type: 'store', 'delivery', or 'any' (the customer picks store or delivery on the page)
    match /feedback_codes/{codeId} {
      allow get: if true;          // the customer page reads its one code (branch + type)
      allow list: if isManager();    // only the admin sees the list of codes
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['branch', 'type', 'place', 'active', 'createdAt', 'createdBy'])
        && request.resource.data.branch in ['shoppies', 'omar_mina', 'omar_abrin']
        && request.resource.data.type in ['delivery', 'store', 'any']
        && request.resource.data.place is string
        && request.resource.data.place.size() >= 1
        && request.resource.data.place.size() <= 60
        && request.resource.data.active is bool;
      allow delete: if isManager();
    }

    // ----- feedback sent by customers -----
    function fbCodeOk(d) {
      let c = /databases/$(database)/documents/feedback_codes/$(d.codeId);
      return exists(c)
        && get(c).data.active == true
        && get(c).data.branch == d.branch
        && (get(c).data.type == d.type || get(c).data.type == 'any');
    }
    function fbAnswersOk(d) {
      return d.answers is map
        && d.answers.values().toSet().hasOnly(['good', 'ok', 'bad'])
        && ((d.type == 'delivery' && d.answers.keys().hasOnly(['speed', 'driver', 'order']))
          || (d.type == 'store' && d.answers.keys().hasOnly(['clean', 'stock', 'staff'])));
    }
    function fbReviewOk(d) {
      return d.stars is int && d.stars >= 1 && d.stars <= 5
        && fbAnswersOk(d)
        && !d.keys().hasAny(['wantsContact', 'contactName', 'contactInfo']);
    }
    function fbComplaintOk(d) {
      return d.text.size() >= 2
        && !d.keys().hasAny(['stars', 'answers'])
        && d.wantsContact is bool
        && ((d.wantsContact == false && !d.keys().hasAny(['contactName', 'contactInfo']))
          || (d.wantsContact == true
            && d.contactName is string && d.contactName.size() <= 80
            && d.contactInfo is string && d.contactInfo.size() >= 3 && d.contactInfo.size() <= 80));
    }
    function fbNewOk(d) {
      return d.keys().hasAll(['codeId', 'branch', 'type', 'kind', 'text', 'lang', 'uid', 'handled', 'createdAt'])
        && d.keys().hasOnly(['codeId', 'branch', 'type', 'kind', 'stars', 'answers', 'text',
                             'wantsContact', 'contactName', 'contactInfo', 'lang', 'uid', 'handled', 'createdAt'])
        && d.uid == request.auth.uid
        && d.createdAt == request.time
        && d.handled == false
        && d.codeId is string && d.codeId.size() <= 40
        && d.text is string && d.text.size() <= 1000
        && d.lang in ['ar', 'en']
        && ((d.kind == 'review' && fbReviewOk(d)) || (d.kind == 'complaint' && fbComplaintOk(d)));
    }
    // every send must also stamp the device's rate counter in the same batch
    function fbRateStamped() {
      return getAfter(/databases/$(database)/documents/feedback_rate/$(request.auth.uid)).data.lastAt == request.time;
    }

    match /feedback/{id} {
      allow create: if fbIsAnon()
        && fbNewOk(request.resource.data)
        && fbCodeOk(request.resource.data)
        && fbRateStamped();
      allow read: if isManager();
      // the admin can only mark a complaint as handled; nothing else changes
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled', 'handledAt', 'handledBy'])
        && request.resource.data.handled is bool;
      allow delete: if isManager();
    }

    // ----- spam limit, per device -----
    // at most 1 send per 60 seconds, and at most 5 sends per 24 hours
    match /feedback_rate/{uid} {
      allow get: if fbIsAnon() && request.auth.uid == uid;
      allow create: if fbIsAnon() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt', 'windowStart', 'n'])
        && request.resource.data.lastAt == request.time
        && request.resource.data.windowStart == request.time
        && request.resource.data.n == 1;
      allow update: if fbIsAnon() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt', 'windowStart', 'n'])
        && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(60, 's')
        && ((request.time < resource.data.windowStart + duration.value(24, 'h')
              && request.resource.data.windowStart == resource.data.windowStart
              && request.resource.data.n == resource.data.n + 1
              && request.resource.data.n <= 5)
          || (request.time >= resource.data.windowStart + duration.value(24, 'h')
              && request.resource.data.windowStart == request.time
              && request.resource.data.n == 1));
    }

    // ---------------- everything else ----------------
    // Same open-to-signed-in behavior as before for every other collection
    // (catalog, settings, fcm_tokens, users, activity_log, ...), EXCEPT:
    //  - the five collections above are left to their own rules (previously
    //    this catch-all also matched them and overrode their limits), and
    //  - a viewer can only read catalog and settings here, and can't write.
    //  - the three customer-feedback collections are left to their own rules
    //    too, so only managers read feedback (not supervisors).
    //  - account documents (users) are only written through their own rules (Oct 2026).
    match /{collection}/{document=**} {
      allow read: if isSignedIn()
                  && !(collection in ['handovers', 'handover_sessions', 'handover_drafts', 'attendance_days', 'attendance_reports', 'merch_visits', 'quick_shortages', 'expiry_items', 'expiry_pulls', 'pull_locks', 'delivery_shifts', 'feedback', 'feedback_codes', 'feedback_rate'])
                  && (!isViewer() || collection in ['catalog', 'settings']);
      // fcm_tokens stays writable while someone is locked: a locked person
      // still has to keep receiving the reminder notifications.
      allow write: if (canWrite() || (collection == 'fcm_tokens' && canWriteBase()))
                   && !(collection in ['handovers', 'handover_sessions', 'handover_drafts', 'attendance_days', 'attendance_reports', 'merch_visits', 'quick_shortages', 'expiry_items', 'expiry_pulls', 'pull_locks', 'delivery_shifts', 'feedback', 'feedback_codes', 'feedback_rate', 'users']);
    }
  }
}
