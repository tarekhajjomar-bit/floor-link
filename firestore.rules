rules_version = '2';

// Floor Link — role-based Firestore rules (Firebase Auth + Custom Claims).
//
// The "role" claim is set by a scheduled GitHub Action (scripts/sync-roles.js)
// from the "role" field on each /users/{uid} document, with a few minutes'
// delay. The read-only "viewer" role is checked from the /users document
// directly (not the claim), so a new viewer is limited from their very first
// sign-in, and the branches they may see come from that same document:
//   companies:        ["omar_mina", "omar_abrin", ...]   (handover, merch, expiry, shortages)
//   deliveryBranches: ["<branch name exactly as the delivery book writes it>", ...]
// The manager ticks both lists in the app's Accounts screen.
//
// Customer feedback (Oct 2026): feedback_codes (QR codes), feedback (replies),
// feedback_rate (spam limit per device). Only managers read feedback.

service cloud.firestore {
  match /databases/{database}/documents {

    // Customers on the public feedback page sign in ANONYMOUSLY. They never
    // count as signed-in employees; they can only send feedback (see below).
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function myDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function myRole() {
      return exists(myDocPath()) ? get(myDocPath()).data.get('role', '') : '';
    }
    function isViewer() {
      return isSignedIn() && myRole() == 'viewer';
    }
    // Manager by claim, or by the users document (covers older "manager" accounts
    // and the minutes before the claim sync runs).
    function isManager() {
      return isAdmin() || (isSignedIn() && myRole() in ['admin', 'manager']);
    }
    function viewerCompanies() {
      return get(myDocPath()).data.get('companies', []);
    }
    function viewerDeliveryBranches() {
      return get(myDocPath()).data.get('deliveryBranches', []);
    }
    // Everyone signed in reads as before; a viewer only reads its own branches.
    function canReadCompany(company) {
      return isSignedIn() && (!isViewer() || company in viewerCompanies());
    }
    // A viewer never writes anything.
    function canWrite() {
      return isSignedIn() && !isViewer();
    }

    // ---------------- users ----------------
    // Unchanged. (Note: the catch-all at the bottom still also covers /users,
    // exactly as before — see the note there.)
    match /users/{userId} {
      // Reading the list stays open to signed-in staff through the catch-all
      // below (supervisors pick the incoming supervisor from it). Writing is
      // only here (Oct 2026): before, the catch-all also let any employee
      // rewrite any account, including their own role.
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isManager()
                    || (isOwner(userId)
                        && request.resource.data.role in ['supervisor', 'merchandiser']);
      allow update: if isManager()
                    || (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['role', 'disabled', 'companies', 'deliveryBranches', 'company', 'department']))
                    // Old username accounts: on first sign-in the new account marks
                    // its old profile as migrated, and nothing else.
                    || (isSignedIn()
                        && !('migratedToUid' in resource.data)
                        && request.resource.data.migratedToUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['migratedToUid']));
      allow delete: if isManager();
    }

    // ---------------- handovers / merch_visits / quick_shortages ----------------
    match /handovers/{docId} {
      allow read: if canReadCompany(resource.data.company);
      allow write: if canWrite();
    }
    match /merch_visits/{docId} {
      allow read: if canReadCompany(resource.data.company);
      allow write: if canWrite();
    }
    match /quick_shortages/{docId} {
      allow read: if canReadCompany(resource.data.company);
      allow write: if canWrite();
    }

    // ---------------- expiry_items ----------------
    // Any signed-in employee can read, create, and make ordinary edits
    // (quantity, category). Only a manager can touch the two fields that
    // remove an item from view: "status" and "deletedInfo". A viewer only
    // reads its own branches.
    match /expiry_items/{itemId} {
      allow read: if canReadCompany(resource.data.company);

      allow create: if canWrite()
                    && request.resource.data.createdBy.userId == request.auth.uid
                    && request.resource.data.status == 'active';

      allow update: if isManager()
                    || (canWrite()
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['status', 'deletedInfo']));

      allow delete: if isManager();
    }

    // ---------------- delivery_shifts ----------------
    // Written by the branch delivery books. Read by managers, by the delivery
    // books themselves, and by a viewer for the delivery books ticked on its account.
    match /delivery_shifts/{docId} {
      allow read: if isManager()
                  || (isSignedIn() && myRole() == 'delivery')
                  || (isViewer() && resource.data.branch in viewerDeliveryBranches());
      allow write: if canWrite();
    }

    // ---------------- attendance (Oct 2026) ----------------
    // Written only by the shop's fingerprint computer (service account, which
    // bypasses these rules). Only the owner reads for now; nobody writes from
    // the app. Keep this list in sync with ATT_OWNERS in index.html.
    function isAttendanceOwner() {
      return isSignedIn() && request.auth.token.email in ['tarek.hajjomar@gmail.com'];
    }
    // HR accounts (role "hr") see attendance too, but never salaries.
    function isHR() {
      return isSignedIn() && myRole() == 'hr';
    }
    match /attendance_days/{day} {
      allow read: if isAttendanceOwner() || isHR();
      allow write: if false;
    }
    match /attendance_reports/{month} {
      allow read: if isAttendanceOwner() || isHR();
      allow write: if false;
    }

    // ---------------- payroll (Oct 2026) ----------------
    // Salaries, limits, warnings, deposits and month closing: the owner only.
    // HR adds advances and discounts and sees them, but never a salary, a net
    // total, a warning, or an employee's advance limit.
    match /pay_staff/{did}     { allow read, write: if isAttendanceOwner(); }
    match /pay_settings/{id}   { allow read, write: if isAttendanceOwner(); }
    match /pay_warnings/{id}   { allow read, write: if isAttendanceOwner(); }
    match /pay_months/{month}  { allow read, write: if isAttendanceOwner(); }
    match /pay_deposit/{id}    { allow read, write: if isAttendanceOwner(); }

    // Names and fingerprint IDs only, so HR can pick an employee.
    match /hr_staff/{did} {
      allow read: if isAttendanceOwner() || isHR();
      allow write: if isAttendanceOwner();
    }
    match /pay_discounts/{id} {
      allow read: if isAttendanceOwner() || isHR();
      allow create: if isAttendanceOwner()
                    || (isHR() && request.resource.data.by == request.auth.uid
                        && request.resource.data.amount is number
                        && request.resource.data.amount > 0);
      allow update, delete: if isAttendanceOwner();
    }
    // Over-limit advance requests: HR asks, the owner decides.
    match /pay_requests/{id} {
      allow read: if isAttendanceOwner() || isHR();
      allow create: if isHR() && request.resource.data.by == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0;
      allow update, delete: if isAttendanceOwner();
    }
    // An HR advance is only accepted together with its month total, and only
    // while that total stays within the employee's limit. The limit lives in
    // pay_staff (owner-only); rules can check it without HR ever reading it.
    function advTotalsPath(key) {
      return /databases/$(database)/documents/pay_adv_totals/$(key);
    }
    function advanceWithinLimit(advId) {
      let a = request.resource.data;
      let key = a.did + '_' + a.month;
      let before = exists(advTotalsPath(key)) ? get(advTotalsPath(key)).data.total : 0;
      let after = getAfter(advTotalsPath(key)).data;
      let limit = get(/databases/$(database)/documents/pay_staff/$(a.did)).data.get('advanceLimit', 0);
      return a.by == request.auth.uid
        && a.amount is number && a.amount > 0
        && a.get('approvedOver', false) == false
        && after.lastId == advId
        && after.total == before + a.amount
        && after.total <= limit;
    }
    match /pay_advances/{advId} {
      allow read: if isAttendanceOwner() || isHR();
      allow create: if isAttendanceOwner() || (isHR() && advanceWithinLimit(advId));
      allow update, delete: if isAttendanceOwner();
    }
    match /pay_adv_totals/{key} {
      allow read: if isAttendanceOwner() || isHR();
      allow write: if isAttendanceOwner()
                   || (isHR()
                       && !exists(/databases/$(database)/documents/pay_advances/$(request.resource.data.lastId))
                       && getAfter(/databases/$(database)/documents/pay_advances/$(request.resource.data.lastId)).data.did + '_'
                          + getAfter(/databases/$(database)/documents/pay_advances/$(request.resource.data.lastId)).data.month == key
                       && request.resource.data.total == (resource == null ? 0 : resource.data.total)
                          + getAfter(/databases/$(database)/documents/pay_advances/$(request.resource.data.lastId)).data.amount);
    }

    // ---------------- activity_log ----------------
    // Unchanged. Append-only; only admins read it.
    match /activity_log/{logId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // =====================================================================
    // ---------------- CUSTOMER FEEDBACK ----------------
    // =====================================================================
    function fbIsAnon() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // ----- QR codes (made from Floor Link, admin only) -----
    // feedback_codes/{codeId}: branch, type, place, active, createdAt, createdBy
    // type: 'store', 'delivery', or 'any' (the customer picks store or delivery on the page)
    match /feedback_codes/{codeId} {
      allow get: if true;          // the customer page reads its one code (branch + type)
      allow list: if isManager();    // only the admin sees the list of codes
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['branch', 'type', 'place', 'active', 'createdAt', 'createdBy'])
        && request.resource.data.branch in ['shoppies', 'omar_mina', 'omar_abrin']
        && request.resource.data.type in ['delivery', 'store', 'any']
        && request.resource.data.place is string
        && request.resource.data.place.size() >= 1
        && request.resource.data.place.size() <= 60
        && request.resource.data.active is bool;
      allow delete: if isManager();
    }

    // ----- feedback sent by customers -----
    function fbCodeOk(d) {
      let c = /databases/$(database)/documents/feedback_codes/$(d.codeId);
      return exists(c)
        && get(c).data.active == true
        && get(c).data.branch == d.branch
        && (get(c).data.type == d.type || get(c).data.type == 'any');
    }
    function fbAnswersOk(d) {
      return d.answers is map
        && d.answers.values().toSet().hasOnly(['good', 'ok', 'bad'])
        && ((d.type == 'delivery' && d.answers.keys().hasOnly(['speed', 'driver', 'order']))
          || (d.type == 'store' && d.answers.keys().hasOnly(['clean', 'stock', 'staff'])));
    }
    function fbReviewOk(d) {
      return d.stars is int && d.stars >= 1 && d.stars <= 5
        && fbAnswersOk(d)
        && !d.keys().hasAny(['wantsContact', 'contactName', 'contactInfo']);
    }
    function fbComplaintOk(d) {
      return d.text.size() >= 2
        && !d.keys().hasAny(['stars', 'answers'])
        && d.wantsContact is bool
        && ((d.wantsContact == false && !d.keys().hasAny(['contactName', 'contactInfo']))
          || (d.wantsContact == true
            && d.contactName is string && d.contactName.size() <= 80
            && d.contactInfo is string && d.contactInfo.size() >= 3 && d.contactInfo.size() <= 80));
    }
    function fbNewOk(d) {
      return d.keys().hasAll(['codeId', 'branch', 'type', 'kind', 'text', 'lang', 'uid', 'handled', 'createdAt'])
        && d.keys().hasOnly(['codeId', 'branch', 'type', 'kind', 'stars', 'answers', 'text',
                             'wantsContact', 'contactName', 'contactInfo', 'lang', 'uid', 'handled', 'createdAt'])
        && d.uid == request.auth.uid
        && d.createdAt == request.time
        && d.handled == false
        && d.codeId is string && d.codeId.size() <= 40
        && d.text is string && d.text.size() <= 1000
        && d.lang in ['ar', 'en']
        && ((d.kind == 'review' && fbReviewOk(d)) || (d.kind == 'complaint' && fbComplaintOk(d)));
    }
    // every send must also stamp the device's rate counter in the same batch
    function fbRateStamped() {
      return getAfter(/databases/$(database)/documents/feedback_rate/$(request.auth.uid)).data.lastAt == request.time;
    }

    match /feedback/{id} {
      allow create: if fbIsAnon()
        && fbNewOk(request.resource.data)
        && fbCodeOk(request.resource.data)
        && fbRateStamped();
      allow read: if isManager();
      // the admin can only mark a complaint as handled; nothing else changes
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled', 'handledAt', 'handledBy'])
        && request.resource.data.handled is bool;
      allow delete: if isManager();
    }

    // ----- spam limit, per device -----
    // at most 1 send per 60 seconds, and at most 5 sends per 24 hours
    match /feedback_rate/{uid} {
      allow get: if fbIsAnon() && request.auth.uid == uid;
      allow create: if fbIsAnon() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt', 'windowStart', 'n'])
        && request.resource.data.lastAt == request.time
        && request.resource.data.windowStart == request.time
        && request.resource.data.n == 1;
      allow update: if fbIsAnon() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt', 'windowStart', 'n'])
        && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(60, 's')
        && ((request.time < resource.data.windowStart + duration.value(24, 'h')
              && request.resource.data.windowStart == resource.data.windowStart
              && request.resource.data.n == resource.data.n + 1
              && request.resource.data.n <= 5)
          || (request.time >= resource.data.windowStart + duration.value(24, 'h')
              && request.resource.data.windowStart == request.time
              && request.resource.data.n == 1));
    }

    // ---------------- everything else ----------------
    // Same open-to-signed-in behavior as before for every other collection
    // (catalog, settings, fcm_tokens, users, activity_log, ...), EXCEPT:
    //  - the five collections above are left to their own rules (previously
    //    this catch-all also matched them and overrode their limits), and
    //  - a viewer can only read catalog and settings here, and can't write.
    //  - the three customer-feedback collections are left to their own rules
    //    too, so only managers read feedback (not supervisors).
    //  - payroll / HR collections (Oct 2026) are left to their own rules, and
    //    account documents (users) are only written through their own rules.
    match /{collection}/{document=**} {
      allow read: if isSignedIn()
                  && !(collection in ['handovers', 'attendance_days', 'attendance_reports', 'merch_visits', 'quick_shortages', 'expiry_items', 'delivery_shifts', 'feedback', 'feedback_codes', 'feedback_rate', 'pay_staff', 'pay_settings', 'pay_warnings', 'pay_months', 'pay_deposit', 'hr_staff', 'pay_discounts', 'pay_requests', 'pay_advances', 'pay_adv_totals'])
                  && (!isViewer() || collection in ['catalog', 'settings']);
      allow write: if canWrite()
                   && !(collection in ['handovers', 'attendance_days', 'attendance_reports', 'merch_visits', 'quick_shortages', 'expiry_items', 'delivery_shifts', 'feedback', 'feedback_codes', 'feedback_rate', 'pay_staff', 'pay_settings', 'pay_warnings', 'pay_months', 'pay_deposit', 'hr_staff', 'pay_discounts', 'pay_requests', 'pay_advances', 'pay_adv_totals', 'users']);
    }
  }
}
