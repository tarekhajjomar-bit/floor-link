rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only real, approved staff accounts: not the anonymous visitors of the customer feedback
    // page, and not a self-registered account still waiting for the manager's approval (Nov 2026).
    function isStaffUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('approved', true) != false;
    }
    // Photos and signatures taken in the app: any signed-in employee can add one
    // (images only, max 8 MB). Nobody can overwrite, list or delete from the app —
    // old ones are removed automatically by the bucket's 30-day lifecycle rule.
    // Reading is by each file's own long random download link, stored with the entry.
    match /photos/{allPaths=**} {
      allow create: if isStaffUser()
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      // 'get' is needed so the app can ask for the file's download link right after uploading.
      allow get: if isStaffUser();
      allow list, update, delete: if false;
    }
    // Catalog/reference photos meant to stay (no automatic removal).
    match /catalog/{allPaths=**} {
      allow create: if isStaffUser()
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      // 'get' is needed so the app can ask for the file's download link right after uploading.
      allow get: if isStaffUser();
      allow list, update, delete: if false;
    }
    // Voice messages from the manager: audio only, max 5 MB, auto-deleted after 30 days.
    match /voice/{allPaths=**} {
      allow create: if isStaffUser()
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
      allow get: if isStaffUser();
      allow list, update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
